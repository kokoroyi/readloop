{
  "name": "readloop",
  "version": "0.1.0",
  "description": "ReadLoop · 本地英语精读工作台：逐句翻译 + AI 批改 + 复盘 + 学习小结（阅读优先，无单词复习）",
  "type": "module",
  "license": "MIT",
  "author": "kokoroyi",
  "homepage": "https://github.com/kokoroyi/readloop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kokoroyi/readloop.git"
  },
  "bugs": {
    "url": "https://github.com/kokoroyi/readloop/issues"
  },
  "keywords": [
    "english",
    "reading",
    "ai",
    "language-learning",
    "local-first",
    "vue",
    "express",
    "sqlite",
    "windows"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js --port 5178",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test \"server/test/unit/*.test.js\" \"server/test/integration/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tray:build": "tray\\build-tray.bat",
    "verify:dict": "node tools/verify-dict.mjs",
    "mock:ai": "node tools/mock-ai.mjs",
    "setup": "setup.bat"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.0",
    "vite": "^7.3.0",
    "vue": "^3.5.0",
    "vue-router": "^5.2.0"
  }
}
